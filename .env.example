# Copy to .env and fill in to switch from offline test mode to Firebase.
# These are public client keys (security comes from firestore.rules), but
# keep .env out of git anyway.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Worldwide course search (golfcourseapi.com). Leave empty to use saved courses only.
EXPO_PUBLIC_GOLFCOURSE_API_KEY=
